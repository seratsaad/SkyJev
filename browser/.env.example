# JEV chooser (required for every JEV run). https://typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# JEV text helper: OpenAI-compatible. The runner strips JEV's `reasoning` field for api.openai.com.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4.1-mini
TEXT_MODEL_REASONING=none
# Baseline (Browser Use) model
OPENAI_API_KEY=
BASELINE_MODEL=gpt-4.1-mini
# Third arm: JEV's action space with an ordinary LLM chooser. Same model as the baseline on purpose,
# so the JEV-vs-baseline difference is the architecture and not the model.
GPT_CHOOSER_MODEL=gpt-4.1-mini
# Chrome with remote debugging. Start it with `make chrome` (scratch profile, does not touch your main Chrome).
BU_CDP_URL=http://127.0.0.1:9222
BU_NAME=astro

# Hard ceiling for one batch of runs, in US dollars. The runner tracks token use and stops itself.
MAX_SPEND_USD=5
# Prices move. Override the table in src/astroweb/budget.py if your provider's rates have changed.
# MODEL_PRICE_IN=0.40
# MODEL_PRICE_OUT=1.60
